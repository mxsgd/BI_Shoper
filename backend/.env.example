# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/bi_shoper
# Optional explicit sync URL for Alembic (defaults to DATABASE_URL without +asyncpg)
# SYNC_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/bi_shoper

# --- GA4 (optional) ---
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=

# --- Tracker (optional) ---
TRACKER_REMOTE_DATABASE_URL=
TRACKER_REMOTE_SSL_INSECURE=0

# --- Shoper App Store (Partner API) ---
# Enable the App Store integration (lifecycle endpoint, iframe auth, OAuth tokens).
SHOPER_APPSTORE_ENABLED=0
# Application ID from the Shoper developer panel (OAuth client_id).
SHOPER_APP_ID=
# App Store secret from the developer panel. Used as the HMAC key for
# lifecycle/iframe signature verification and as the OAuth client_secret.
SHOPER_APP_SECRET=
# Fernet key used to encrypt access/refresh tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHOPER_TOKEN_CIPHER_KEY=
# Optional dedicated secret for signing iframe app sessions (falls back to SHOPER_APP_SECRET).
SHOPER_SESSION_SECRET=
# Frontend URL the iframe entry endpoint redirects to after issuing a session.
SHOPER_PANEL_REDIRECT_URL=/
# Max accepted age (seconds) of the iframe `timestamp` parameter.
SHOPER_IFRAME_MAX_AGE_SECONDS=300
# App session lifetime in seconds.
SHOPER_SESSION_TTL_SECONDS=1800
# Development only: allow http:// shop URLs (never enable in production).
SHOPER_ALLOW_INSECURE_SHOP_URL=0

# --- DEPRECATED: legacy WebAPI login/password auth ---
# Only for stores WITHOUT an App Store installation. Disabled by default.
SHOPER_ENABLE_LEGACY_WEBAPI=0
# SHOPER_STORE_1_LOGIN=
# SHOPER_STORE_1_PASSWORD=
# SHOPER_DEFAULT_LOGIN=
# SHOPER_DEFAULT_PASSWORD=
